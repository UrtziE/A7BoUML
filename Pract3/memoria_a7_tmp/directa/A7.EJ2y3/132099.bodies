class ConnectionManager
!!!165507.java!!!	ConnectionManager(in dbname : String)
		Class.forName("org.hsqldb.jdbcDriver");
		sourceURL = "jdbc:hsqldb:file:./data/" + dbname;
!!!165635.java!!!	connect() : void
		if (dbcon == null)
				dbcon = DriverManager.getConnection(sourceURL);
!!!165763.java!!!	close() : void
		if (dbcon != null) {
				dbcon.close();
				dbcon = null;
		}
!!!165891.java!!!	updateDB(in sql : String) : void
		if (dbcon != null) {
				Statement sentencia = dbcon.createStatement();
				sentencia.executeUpdate(sql);
		}
!!!166019.java!!!	queryDB(in sql : String) : ResultSet
		if (dbcon != null) {
				Statement sentencia = dbcon.createStatement();
				return sentencia.executeQuery(sql);
		}
		return null;
