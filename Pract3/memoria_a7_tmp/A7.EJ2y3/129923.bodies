class EntregaDTO
!!!134403.java!!!	EntregaDTO(in id : int, inout fecha : LocalDateTime, in tipoSeguro : String, in kms : double, in combustible : double, in tiene_asociado : String, in es_realizada_por : String)
		super();
		this.id = id;
		this.fecha = fecha;
		this.tipoSeguro = tipoSeguro;
		this.kms = kms;
		this.combustible = combustible;
		this.tiene_asociado = tiene_asociado;
		this.es_realizada_por = es_realizada_por;
!!!134531.java!!!	EntregaDTO(inout e : Entrega)
		
		this.id = e.getId();
		this.fecha =e.getFecha();
		this.tipoSeguro =e.getTipoSeguro();
		this.kms = e.getKms();
		this.combustible = e.getCombustible();
		this.tiene_asociado = e.getTiene_asociado().getMatricula();
		this.es_realizada_por = e.getEs_realizada_por().getDNI();
