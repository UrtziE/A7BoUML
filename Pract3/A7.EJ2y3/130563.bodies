class Entrega
!!!154755.java!!!	Entrega(in id : int, inout fecha : LocalDateTime, in tipoSeguro : String, in kms : double, in combustible : double, inout tiene_asociado : Coche, inout asociado_a_reserva : Reserva, inout es_realizada_por : Empleado)
		super();
		this.id = id;
		this.fecha = fecha;
		this.tipoSeguro = tipoSeguro;
		this.kms = kms;
		this.combustible = combustible;
		this.tiene_asociado = tiene_asociado;
		this.asociado_a_reserva = asociado_a_reserva;
		this.es_realizada_por = es_realizada_por;

!!!154883.java!!!	Entrega(inout e : EntregaDTO)
		this.id = e.getId();
		this.fecha = e.getFecha();
		this.tipoSeguro = e.getTipoSeguro();
		this.kms = e.getKms();
		this.combustible = e.getCombustible();
		this.tiene_asociado = new Coche(DAL.getSingleton().getCoche(e.getTiene_asociado()));
		this.asociado_a_reserva = new Reserva(DAL.getSingleton().getReserva(e.getId()));
		this.es_realizada_por = new Empleado(DAL.getSingleton().getEmpleado(e.getEs_realizada_por()));
!!!155011.java!!!	addDanyo(inout c : Danyo) : void
		coleccionDanyos.put(c.getIdDanyo(), c);
!!!155139.java!!!	removeDanyo(in idDanyo : String) : Danyo
		return coleccionDanyos.remove(idDanyo);	
!!!155267.java!!!	getDanyo(in idDanyo : String) : Danyo
		return coleccionDanyos.get(idDanyo);
!!!155395.java!!!	getId() : int
		return id;
!!!155523.java!!!	setId(in id : int) : void
		this.id = id;
!!!155651.java!!!	getFecha() : LocalDateTime
		return fecha;
!!!155779.java!!!	setFecha(inout fecha : LocalDateTime) : void
		this.fecha = fecha;
!!!155907.java!!!	getTipoSeguro() : String
		return tipoSeguro;
!!!156035.java!!!	setTipoSeguro(in tipoSeguro : String) : void
		this.tipoSeguro = tipoSeguro;
!!!156163.java!!!	getKms() : double
		return kms;
!!!156291.java!!!	setKms(in kms : double) : void
		this.kms = kms;
!!!156419.java!!!	getCombustible() : double
		return combustible;
!!!156547.java!!!	setCombustible(in combustible : double) : void
		this.combustible = combustible;
!!!156675.java!!!	getTiene_asociado() : Coche
		return tiene_asociado;
!!!156803.java!!!	setTiene_asociado(inout tiene_asociado : Coche) : void
		this.tiene_asociado = tiene_asociado;
!!!156931.java!!!	getAsociado_a_devolucion() : Devolucion
		return asociado_a_devolucion;
!!!157059.java!!!	setAsociado_a_devolucion(inout asociado_a_devolucion : Devolucion) : void
		this.asociado_a_devolucion = asociado_a_devolucion;
